                {
                  "type": "text",
                  "id": "TkBzH",
                  "name": "Para",
                  "fill": "$foreground",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Quicket is the only official resale channel. Tickets are transferred through Quicket's own system so the barcode stays valid at the gate. AfrikaBurn does not sell, resell, or transfer tickets directly — and we will never DM you a ticket link.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-brand",
                  "fontSize": 14.5,
                  "fontWeight": "500"
                },
