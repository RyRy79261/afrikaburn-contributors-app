{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local", ".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION",
    "AUTH_RATE_LIMIT_WINDOW_SECONDS",
    "AUTH_RATE_LIMIT_MAX",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "RESEND_API_KEY",
    "GOD_EMAILS",
    "BLOB_READ_WRITE_TOKEN",
    "PGCRYPTO_KEY",
    "NEON_LOCAL_PROXY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // EXCLUSIONS ARE LOAD-BEARING. `.next/**` as an output means turbo tars
      // the whole directory into .turbo/cache on every task hash and writes it
      // back on every restore, so anything unbounded under .next multiplies by
      // the number of builds.
      //
      // `!.next/cache/**` was always here. `!.next/dev/**` was added 29 Jul
      // 2026 after it filled a developer's machine: Next 16's dev server writes
      // Turbopack state to `.next/dev` and it grows without bound — measured
      // 5.7 GB for web and 4.6 GB for org after ONE dev-mode e2e run. Every
      // build after that archived those ten gigabytes under a fresh hash (any
      // source edit changes the hash) and restored them again on every hit. A
      // dozen build-and-test cycles reached ~550 GB and filled the disk.
      //
      // scripts/e2e-local.sh also deletes `.next/dev` before a dev-mode run.
      // Keep both: this stops it being COPIED, that stops it ACCUMULATING.
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "out/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  }
}
