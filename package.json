  "version": "0.0.0",
  "description": "AfrikaBurn Contributors App \u2014 participant + org apps for theme-camp registration and entitlements (Quagga Portal MVP)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyRy79261/afrikaburn-contributors-app.git"
  },
  "homepage": "https://github.com/RyRy79261/afrikaburn-contributors-app#readme",
  "bugs": {
    "url": "https://github.com/RyRy79261/afrikaburn-contributors-app/issues"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "e2e:local": "./scripts/e2e-local.sh",
    "labels:sync": "tsx scripts/setup-github-labels.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
