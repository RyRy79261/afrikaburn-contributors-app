{
  "name": "quagga-portal-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "AfrikaBurn Contributors App — participant + org apps for theme-camp registration and entitlements (Quagga Portal MVP)",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "better-auth": "1.4.18",
      "esbuild": ">=0.28.1"
    }
  }
}
