{
  "name": "quagga-portal-workspace",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "version": "0.0.0",
  "description": "AfrikaBurn Contributors App — participant + org apps for theme-camp registration and entitlements (Quagga Portal MVP)",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "e2e:local": "./scripts/e2e-local.sh",
    "labels:sync": "tsx scripts/setup-github-labels.ts",
    "prepare": "husky",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "monocart-coverage-reports": "^2.12.12",
    "prettier": "^3.8.3",
    "tsx": "^4.23.5",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
