# Quagga Portal — example environment variables.
# Every var here is OPTIONAL for boot: both apps render a landing page and a
# graceful "not configured" banner when these are unset. Copy to `.env` at the
# repo root (or `.env.local` inside an app) and fill in to enable the DB- and
# auth-backed flows.
#
# When you ADD a variable, also add it to turbo.json `globalEnv` in the same
# change (mirrored from the Camp 404 convention) — otherwise Turbo's cache
# won't invalidate on a value change and you'll get stale builds.

# --- Database (Neon Postgres) ---
# Pooled/HTTP connection string. Migrations are only ever applied MANUALLY once
# this exists (`pnpm --filter @quagga/db db:migrate`); the build never migrates.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Neon Auth (Better Auth) ---
# Base URL from Neon Console -> your project -> Auth -> Configuration.
# Cookie secret must be 32+ chars: `openssl rand -base64 32`.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# --- Email (Resend) ---
# Handles auth / magic-link / notification delivery. Unset -> email flows are
# skipped rather than crashing.
RESEND_API_KEY=

# --- God bootstrap ---
# Comma-separated email list. On first login a matching address is granted the
# `god` membership on the seeded AfrikaBurn org group.
GOD_EMAILS=

# --- File storage (Vercel Blob) ---
# Backs registration layout uploads (Section 4, max 4 images).
BLOB_READ_WRITE_TOKEN=

# --- Crypto (POPIA) ---
# Symmetric key for the always-private, encrypted ID-document columns on
# burner_bios (SA ID / passport). 16+ chars required, 32+ recommended. Rotate
# annually. `openssl rand -base64 32`.
PGCRYPTO_KEY=
