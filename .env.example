# Quagga Portal — example environment variables.
#
# Every var here is OPTIONAL FOR BOOT: all three apps render a landing page and
# a graceful "not configured" banner when these are unset (AGENTS.md rule 4).
# Copy to `.env` at the repo root (or `.env.local` inside an app) and fill in
# to enable the DB- and auth-backed flows.
#
# When you ADD a variable, add it to turbo.json `globalEnv` in the same change
# — otherwise Turbo's cache won't invalidate on a value change and you'll get
# stale builds. The org console's System panel reads most of these back, so a
# missing one shows up there rather than as a crash.
#
# E2E_* variables are NOT listed here; they configure the Playwright suite
# only. See e2e/README.md.

# =============================================================================
# Database (Neon Postgres)
# =============================================================================
# Pooled/HTTP connection string — what the apps use at runtime.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Direct (unpooled) connection. MIGRATIONS RUN OVER THIS, not the pooled URL:
# session advisory locks do not hold through PgBouncer, so the migrate step
# ABORTS on a pooler host. On a PRODUCTION deploy it also refuses to fall back
# to DATABASE_URL when this is unset (Neon's default makes that URL the pooled
# endpoint even when the host string doesn't say so). Outside production it
# falls back with a loud warning.
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# NOTE ON MIGRATIONS: every app's `build` script is
# `db:migrate:deploy && next build`, so a deploy DOES migrate — under an
# advisory lock, so three apps building concurrently is safe. Watch the
# `[migrate]` lines in the Vercel build log on first deploy. See docs/deploy.md.

# Log every SQL statement to stdout. Dev debugging only — noisy.
QUAGGA_SQL_LOG=

# =============================================================================
# Auth (self-hosted Better Auth)
# =============================================================================
# THE shared signing secret. This one var is what makes a session minted by one
# app valid in the others, so all three deployments MUST carry the same value.
# 32+ chars: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# This app's own absolute origin in production (per-app, not shared).
# Falls back to VERCEL_URL on previews and localhost in dev.
BETTER_AUTH_URL=

# Set `false` to let unverified users sign in. Defaults to REQUIRED (any value
# other than an explicit false). Turning it off with an email provider
# configured raises a warning on the System panel.
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=

# Auth rate-limit tuning. LEAVE UNSET IN PRODUCTION — Better Auth's own
# defaults plus the per-route custom rules apply. Present for local testing.
AUTH_RATE_LIMIT_WINDOW_SECONDS=
AUTH_RATE_LIMIT_MAX=

# Google social sign-in. Both must be set or the provider stays off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# Email (Resend)
# =============================================================================
# Backs verification, password reset and notification delivery. Unset -> email
# flows are skipped rather than crashing.
RESEND_API_KEY=

# =============================================================================
# God bootstrap
# =============================================================================
# Comma-separated email list. On first login a matching address is granted the
# `god` membership on the seeded AfrikaBurn org group. Set TWO addresses — a
# single god account is a lockout risk (the System panel enforces this rule).
GOD_EMAILS=

# =============================================================================
# File storage (Vercel Blob)
# =============================================================================
# Backs registration layout uploads (Section 4, max 4 images) and supplier
# document uploads.
BLOB_READ_WRITE_TOKEN=

# =============================================================================
# Crypto (POPIA)
# =============================================================================
# Symmetric key for the always-private, encrypted ID-document columns on
# burner_bios (SA ID / passport). 16+ chars required, 32+ recommended. Rotate
# annually. `openssl rand -base64 32`.
PGCRYPTO_KEY=

# =============================================================================
# Scheduled jobs (Vercel Cron)
# =============================================================================
# Vercel Cron authenticates its GET by injecting `Authorization: Bearer
# $CRON_SECRET`. Each job ALSO accepts its own dedicated secret, so an operator
# can trigger it manually without holding the platform-wide cron token.
#
# These fail CLOSED: with the job's own secret unset, the route still responds
# but refuses to do any work. An unauthenticated endpoint that erases accounts
# should not exist even briefly.
CRON_SECRET=
ACCOUNT_SWEEP_SECRET=
REGISTRATION_REMINDER_SECRET=

# =============================================================================
# In-app reporter
# =============================================================================
# Files issues from the in-app report dialog. Needs `issues: write` on the
# target repo. Unset -> the reporter is hidden rather than failing on submit.
GITHUB_TOKEN=
# owner/repo to file into. Defaults to RyRy79261/afrikaburn-contributors-app.
GITHUB_REPO=

# Optional: restructures a free-text report into a titled, labelled issue.
# Unset -> the raw description is filed as-is (never an error).
ANTHROPIC_API_KEY=

# Optional: server-side Whisper transcription for dictated reports. Unset ->
# the microphone control is HIDDEN, not offered-then-broken.
GROQ_API_KEY=

# =============================================================================
# Cross-app links (public — these are inlined into the client bundle)
# =============================================================================
# This app's public origin, used to build absolute links in outbound email.
NEXT_PUBLIC_APP_URL=
# Where org/suppliers link back to the participant app. Defaults to
# http://localhost:3000.
NEXT_PUBLIC_PARTICIPANT_APP_URL=
# Shown on the client-error diagnostics panel. Defaults to "unknown".
NEXT_PUBLIC_APP_VERSION=

# =============================================================================
# Neon Local proxy (dev-only escape hatch)
# =============================================================================
# Set to `1` ONLY when running the seed/migrate scripts against a Neon Local
# proxy container: it reconfigures the serverless driver to use a plain
# ws://host:5433/v1 WebSocket instead of secure Neon. Never set in production.
NEON_LOCAL_PROXY=
# Host and ports for that container. Defaults: localhost / 4444 / 5433.
NEON_LOCAL_PROXY_HOST=
NEON_LOCAL_HTTP_PORT=
NEON_LOCAL_WS_PORT=
