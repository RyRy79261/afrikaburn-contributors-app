{
  "name": "@quagga/org",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "pnpm --filter @quagga/db db:migrate:deploy && next build",
    "vercel-build": "pnpm --filter @quagga/db db:migrate:deploy && next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.25",
    "@quagga/auth": "workspace:*",
    "@quagga/core": "workspace:*",
    "@quagga/db": "workspace:*",
    "@quagga/types": "workspace:*",
    "@quagga/ui": "workspace:*",
    "@vercel/blob": "^2.8.2",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@quagga/eslint-config": "workspace:*",
    "@quagga/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
