  "devDependencies": {
    "@quagga/eslint-config": "workspace:*",
    "@quagga/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.0",
